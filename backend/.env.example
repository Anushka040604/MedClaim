ENV=dev
APP_NAME=Medical Claim Verification
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

DATABASE_URL=postgresql+psycopg2://mcv:mcv@localhost:5432/mcv

SESSION_SECRET=change-me-in-production

STORAGE_DIR=storage

# OCR
# PDFs are parsed with PyMuPDF text extraction.

# RAG storage
POLICIES_DIR=policies
CHROMA_DIR=storage/chroma
RAG_USE_VECTORS=false

# Optional notifications (safe no-op if empty)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Groq (OpenAI-compatible chat completions)
# IMPORTANT: do not commit real keys.
GROQ_API_KEY=
GROQ_MODEL_EXTRACTION=groq/compound
GROQ_MODEL_REASONING=groq/compound

# Groq load-shaping (process-wide)
# These reduce burst load and help avoid Groq 429 TPM/RPM on smaller tiers.
GROQ_MAX_CONCURRENCY=1
GROQ_REQUESTS_PER_MINUTE=10
# Estimate only: provider TPM accounting is authoritative. Keep slightly below your org limit.
GROQ_TOKENS_PER_MINUTE=6500
GROQ_CALL_DELAY_SECONDS=0.2
GROQ_RETRY_MAX_ATTEMPTS=8